{
  "name": "move.it",
  "version": "auto",
  "private": true,
  "license": "MIT",
  "authors": [
    "RocketSeat",
    "Julio L. Muller"
  ],
  "homepage": "https://jlm-moveit.vercel.app/",
  "scripts": {
    "postinstall": "node -e \"require('fs').existsSync('.env') || require('fs').copyFileSync('.env.example', '.env')\"",
    "prepare": "husky || true",
    "commit": "commit",
    "release": "semantic-release",
    "development": "next dev --port 30303",
    "dev": "bun run development",
    "production": "next start --port 30303",
    "prod": "bun run production",
    "build": "next build",
    "lint": "eslint --fix src/ eslint.config.mjs next.config.ts"
  },
  "dependencies": {
    "js-cookie": "^3.0.5",
    "next": "^16.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@commitlint/prompt-cli": "^20.2.0",
    "@eslint/eslintrc": "^3.3.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^22.19.3",
    "@types/react": "^19.2.7",
    "eslint": "^9.39.2",
    "eslint-config-any": "^2.2.1",
    "eslint-config-next": "^16.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "sass": "^1.97.0",
    "typescript": "^5.9.3"
  }
}
